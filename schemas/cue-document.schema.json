{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versesync.internal/schemas/cue-document.schema.json",
  "title": "VerseSync Cue Document",
  "description": "The sidecar's output, the panel's input, and the on-disk save format (FR-6.8). See docs/07-sidecar-api.md §5. All times are source seconds, never sequence ticks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "job", "translation", "transcript", "cues", "warnings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "major.minor. Per docs/07-sidecar-api.md §5.2: a reader accepts any matching major and warns on a newer minor; a major mismatch is refused with an explanation rather than a parse error. A writer emits 1.0 unless the document was built from a scripture file, which makes it 1.1 (docs/07-sidecar-api.md §5.2, docs/14-scripture-file-import.md §6). 1.1 only adds optional fields, flags and warning codes."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "media_path", "media_hash", "media_duration_s", "model", "quantization", "device", "language", "options"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "media_path": { "type": "string", "minLength": 1 },
        "media_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" },
        "media_duration_s": { "type": "number", "minimum": 0 },
        "model": { "type": "string", "minLength": 1 },
        "quantization": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "enum": ["cuda", "cpu"] },
        "language": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "abbreviation", "name", "attribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "abbreviation": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_count", "words_ref"],
      "properties": {
        "word_count": { "type": "integer", "minimum": 0 },
        "words_ref": { "type": "string", "minLength": 1 }
      }
    },
    "scripture_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "entry_count"],
      "description": "Added in 1.1. Present only when the cues were built from an EasyWorship export (docs/14-scripture-file-import.md §6), so Journey B and the review list can show what they came from.",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex SHA-256 of the file's bytes, with no \"sha256:\" prefix."
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Entries parsed from the file. An empty file is an input error (scripture_file_empty), so a document never has 0."
        }
      }
    },
    "cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/cue" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "osis", "chapter"],
      "properties": {
        "book": { "type": "string", "minLength": 1 },
        "osis": { "type": "string", "minLength": 1 },
        "chapter": { "type": "integer", "minimum": 1 },
        "verse": {
          "type": "integer",
          "minimum": 1,
          "description": "Absent for a chapter-only reference (D12) — flagged chapter_only and disabled by default, never auto-expanded."
        },
        "verse_end": { "type": "integer", "minimum": 1 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "contextual", "book_match", "token_span", "word_span"],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12"],
          "description": "Grammar pattern from docs/04-reference-detection.md §4. P11/P12 are context-carried (verse-only) matches."
        },
        "contextual": {
          "type": "boolean",
          "description": "True when the reference was carried from a preceding mention (P11/P12) rather than naming its own book/chapter."
        },
        "book_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "distance"],
          "properties": {
            "tier": { "type": "string", "enum": ["exact", "alias", "fuzzy"] },
            "distance": { "type": "integer", "minimum": 0 }
          }
        },
        "token_span": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "word_span": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "reference_display", "body", "confidence"],
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "reference_display": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": {
          "type": "string",
          "description": "Short human-readable note on why this competed, e.g. the Psalms concatenation ambiguity (docs/04-reference-detection.md §3.1)."
        }
      }
    },
    "flag": {
      "type": "string",
      "enum": [
        "low_confidence",
        "overlap",
        "truncated",
        "long_passage",
        "text_unavailable",
        "passage_not_found",
        "chapter_only",
        "suppressed_duplicate",
        "not_in_export",
        "not_found_in_audio",
        "repeat_mention",
        "repeat_read",
        "out_of_order",
        "cut_from_edit",
        "multiple_placements",
        "speed_change_unsupported"
      ],
      "description": "The review list's colour source (docs/07-sidecar-api.md §5.1). cut_from_edit, multiple_placements and speed_change_unsupported are added by the panel after source->sequence mapping; the sidecar never emits them. not_in_export, not_found_in_audio, repeat_mention, repeat_read and out_of_order were added in 1.1 and come only from a scripture file (docs/14-scripture-file-import.md §5)."
    },
    "text_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "translation"],
      "description": "Added in 1.1. Where the cue's body came from. Absent on a 1.0 cue, which is always provider text.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["export", "provider"],
          "description": "export: the scripture file's own text, used verbatim. provider: fetched from the Bible text service."
        },
        "translation": {
          "type": "string",
          "minLength": 1,
          "description": "Abbreviation of the translation the body is in, e.g. NIV."
        },
        "entry_index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position of the entry in the scripture file, repeats counted. Several cues can share one. Present for export, absent for provider."
        }
      },
      "if": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "export" } }
      },
      "then": { "required": ["entry_index"] },
      "else": { "properties": { "entry_index": false } }
    },
    "verse_offsets_s": {
      "type": "object",
      "description": "Added in 1.1. On a READ cue of a multi-verse export entry: the start of each later verse, in seconds after source_anchor_s, keyed by verse number. A verse with no matched word has no key.",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "enabled", "origin",
        "reference", "reference_display", "body", "body_word_count", "body_truncated",
        "source_anchor_s", "source_duration_s", "mention_start_s", "mention_end_s",
        "classification", "confidence", "snippet", "flags", "alternatives"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "origin": {
          "type": "string",
          "enum": ["detected", "manual", "edited"],
          "description": "Manual cues have no detection block, a confidence of 1.0, and their anchor supplied by the editor."
        },
        "reference": { "$ref": "#/$defs/reference" },
        "reference_display": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "body_word_count": { "type": "integer", "minimum": 0 },
        "body_truncated": { "type": "boolean" },
        "source_anchor_s": { "type": "number", "minimum": 0 },
        "source_duration_s": { "type": "number", "minimum": 0 },
        "mention_start_s": { "type": "number", "minimum": 0 },
        "mention_end_s": { "type": "number", "minimum": 0 },
        "classification": { "type": "string", "enum": ["read", "paraphrase"] },
        "read_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "read_start_s": { "type": "number", "minimum": 0 },
        "read_end_s": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detection": { "$ref": "#/$defs/detection" },
        "snippet": { "type": "string" },
        "text_source": { "$ref": "#/$defs/text_source" },
        "verse_offsets_s": { "$ref": "#/$defs/verse_offsets_s" },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/flag" }
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Added in 1.1. The 1-based line of the scripture file the warning is about. Required for export_reference_invalid and export_block_unreferenced."
        }
      },
      "if": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "enum": ["export_reference_invalid", "export_block_unreferenced"] } }
      },
      "then": { "required": ["line"] }
    }
  }
}
